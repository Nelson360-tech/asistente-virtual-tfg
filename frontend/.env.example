# URL base del backend FastAPI
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Tiempo máximo de espera de la petición, en milisegundos
NUXT_PUBLIC_API_TIMEOUT_MS=60000

# true: el modo demostración está activado al abrir la página
# false: se usa el backend real (el interruptor sigue visible para pruebas)
NUXT_PUBLIC_DEMO_MODE=true
