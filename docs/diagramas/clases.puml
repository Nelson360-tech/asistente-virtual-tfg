@startuml
!include comun.iuml
title Diagrama de clases del backend de Donna
hide empty members

package "backend" {
  class main <<module>> {
    + app : FastAPI
    + stt : SpeechToText
    + commands : Commands
    + tts : TextToSpeech
    + lip_sync : LipSync
    + history : History
    --
    + health() : dict
    + ask(audio : UploadFile) : dict
    + get_history(limit : int = 20) : list[dict]
  }
}

package "donna" {
  class SpeechToText {
    - model : WhisperModel
    --
    + __init__(model_size : str = "base")
    + transcribe(audio_file, language : str = "es") : str
  }
  class Commands {
    + execute(question : str) : dict
    - _reply(answer : str, action : dict = None) : dict
  }
  class TextToSpeech {
    - voice : PiperVoice
    + sample_rate : int
    - output_dir : Path
    --
    + __init__(voice_path : Path, output_dir : Path)
    + synthesize(text : str) : tuple[str, list[PhonemeAlignment]]
  }
  class History {
    - db_path : Path
    --
    + __init__(db_path : Path)
    + add(question, answer, audio_file, t_stt_ms, t_tts_ms, t_total_ms, ...)
    + latest(limit : int = 20) : list[dict]
    - _execute(sql : str, params) : list
  }
  class LipSync {
    - fps : int = 30
    --
    + visemes(alignments : list[PhonemeAlignment], sample_rate : int) : list[dict]
  }
}

package "bibliotecas externas" <<Frame>> {
  class WhisperModel <<faster_whisper>>
  class PiperVoice <<piper>>
  class PhonemeAlignment <<piper>> {
    + phoneme : str
    + num_samples : int
  }
  class "sqlite3" as SQL <<module>>
  class "openfacefx" as OFX <<module>> {
    + parse_piper_alignments()
    + generate_from_alignment()
    + dominant_cues()
  }
}

main *-- "1" SpeechToText
main *-- "1" Commands
main *-- "1" TextToSpeech
main *-- "1" LipSync
main *-- "1" History

SpeechToText *-- "1" WhisperModel
TextToSpeech *-- "1" PiperVoice
TextToSpeech ..> PhonemeAlignment : <<create>>
LipSync ..> PhonemeAlignment : <<use>>
LipSync ..> OFX : <<use>>
History ..> SQL : <<use>>
@enduml
